{
  "name": "runjs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite --host",
    "postinstall": "node scripts/sync-wasm.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:favicons": "node scripts/generate-favicons.js",
    "prerender:routes": "node scripts/prerender-routes.js",
    "verify:seo": "node scripts/verify-seo.js",
    "test:visualizer": "node scripts/test-visualizer.js",
    "test:context": "node scripts/test-execution-context.js",
    "test:interlink": "node scripts/test-cross-tool-interlink.js",
    "test:reset-modal": "node scripts/test-reset-modal.js",
    "test:output-questions": "node scripts/test-output-questions.js",
    "test:complexity": "node scripts/test-complexity.js",
    "test:react": "node scripts/test-react-playground.js",
    "build": "node scripts/generate-sitemap.js && tsc -b && vite build && node scripts/prerender-routes.js",
    "lint": "eslint ./src",
    "pretty": "prettier --write ./src",
    "preview": "vite preview",
    "check": "npm run pretty && npm run lint",
    "pages:dev": "wrangler pages dev ./dist",
    "pages:deploy": "pnpm run build && wrangler pages deploy ./dist",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm run build && wrangler deploy",
    "deploy": "pnpm run worker:deploy"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "emmet-monaco-es": "^5.7.0",
    "esbuild-wasm": "^0.28.2",
    "idb": "^8.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.43.0",
    "luna-console": "^1.3.6",
    "luna-object-viewer": "^0.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "react-split": "^2.0.14",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  }
}
