{
  "name": "runjs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "dev": "vite --host",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:favicons": "node scripts/generate-favicons.js",
    "prerender:routes": "node scripts/prerender-routes.js",
    "verify:seo": "node scripts/verify-seo.js",
    "test:visualizer": "node scripts/test-visualizer.js",
    "test:context": "node scripts/test-execution-context.js",
    "test:interlink": "node scripts/test-cross-tool-interlink.js",
    "test:reset-modal": "node scripts/test-reset-modal.js",
    "test:output-questions": "node scripts/test-output-questions.js",
    "test:complexity": "node scripts/test-complexity.js",
    "test:react": "node scripts/test-react-playground.js",
    "test": "npm run test:output-questions && npm run test:complexity && npm run test:visualizer && npm run test:context && npm run test:interlink && npm run test:reset-modal && npm run test:react",
    "build": "node scripts/generate-sitemap.js && tsc -b && vite build && node scripts/prerender-routes.js",
    "lint": "eslint ./src",
    "pretty": "prettier --write ./src",
    "preview": "vite preview",
    "check": "npm run pretty && npm run lint",
    "pages:dev": "wrangler pages dev ./dist",
    "pages:deploy": "pnpm run build && wrangler pages deploy ./dist",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm run build && wrangler deploy",
    "deploy": "pnpm run pages:deploy"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "emmet-monaco-es": "^5.5.0",
    "esbuild-wasm": "^0.27.0",
    "idb": "^8.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.38.0",
    "luna-console": "^1.3.5",
    "luna-object-viewer": "^0.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "react-split": "^2.0.14",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/acorn": "^6.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.1",
    "wrangler": "^4.127.1"
  }
}
